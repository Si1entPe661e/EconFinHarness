# Public root allowlist. Corpus and build-workstation material stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/CHANGELOG.md
!/LICENSE
!/harness/
!/tools/
!/examples/
!/.agents/
!/.claude/
!/.codex/
/harness_build/

# Public tools only.
/tools/*
!/tools/README.md
!/tools/fh.py
!/tools/fh_common.py
!/tools/fh_adapters.py
!/tools/fh_cards.py
!/tools/fh_index.py

# Selected research examples only.
/examples/*
!/examples/README.md
!/examples/code-cards/
!/examples/paper-notes/
!/examples/exclusions/
/examples/code-cards/*
!/examples/code-cards/*.json
/examples/paper-notes/*
!/examples/paper-notes/*.json
/examples/exclusions/*
!/examples/exclusions/*.json

# Host configuration allowlists.
/.agents/*
!/.agents/skills/
/.claude/*
!/.claude/agents/
!/.claude/skills/
/.codex/*
!/.codex/agents/
!/.codex/config.toml

# Historical bookkeeping is not needed by host skills.
**/skills/**/manifest.json
**/skills/**/evidence.json
**/skills/**/reported_evidence.json

# Private configuration, credentials, editor state and runtime artifacts.
.env
.env.*
*.local.*
settings.local.json
auth.json
credentials.json
*.pem
*.key
id_rsa*
id_ed25519*
.DS_Store
.idea/
.vscode/
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.Rhistory
.RData
.Rproj.user/
*.log
*.sqlite
*.sqlite3
*.db
*.pdf
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.dta
*.parquet
*.feather
*.rds
*.Rds
*.pkl
