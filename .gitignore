# Public root allowlist. Local corpus and workstation material stay outside Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/LICENSE
!/NOTICE.md
!/harness/
!/harness_build/
!/.agents/
!/.claude/
!/.codex/

# Include only reusable materials from the build workstation.
/harness_build/*
!/harness_build/README.md
!/harness_build/cli/
!/harness_build/agents/
!/harness_build/skills/
!/harness_build/recipes/
!/harness_build/papers/
!/harness_build/evals/
/harness_build/cli/*
!/harness_build/cli/README.md
!/harness_build/cli/fh.py
!/harness_build/cli/fh_common.py
!/harness_build/cli/fh_adapters.py
!/harness_build/cli/fh_cards.py
!/harness_build/cli/fh_index.py
!/harness_build/cli/fhb.py
/harness_build/agents/*
!/harness_build/agents/*.md
/harness_build/recipes/*
!/harness_build/recipes/accepted/
/harness_build/papers/*
!/harness_build/papers/notes/
/harness_build/evals/*
!/harness_build/evals/holdout/
/harness_build/evals/holdout/*
!/harness_build/evals/holdout/*.json

# Host configuration allowlists.
/.agents/*
!/.agents/skills/
/.claude/*
!/.claude/agents/
!/.claude/skills/
/.codex/*
!/.codex/agents/
!/.codex/config.toml

# Historical bookkeeping is not needed by host skills.
**/skills/**/manifest.json
**/skills/**/evidence.json
**/skills/**/reported_evidence.json

# Private configuration, credentials, editor state and runtime artifacts.
.env
.env.*
*.local.*
settings.local.json
auth.json
credentials.json
*.pem
*.key
id_rsa*
id_ed25519*
.DS_Store
.idea/
.vscode/
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.Rhistory
.RData
.Rproj.user/
*.log
*.sqlite
*.sqlite3
*.db
*.pdf
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.dta
*.parquet
*.feather
*.rds
*.Rds
*.pkl
