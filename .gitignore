# Public root allowlist. Corpus and build-workstation material stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/CHANGELOG.md
!/LICENSE
!/harness/
!/.agents/
!/.claude/
!/.codex/
/harness_build/
/tools/
/examples/

# Tool entry points. Content is maintained under harness/.
/.agents/*
!/.agents/skills
/.claude/*
!/.claude/agents
!/.claude/skills
/.codex/*
!/.codex/config.toml

# Historical bookkeeping is not needed by host skills.
**/skills/**/manifest.json
**/skills/**/evidence.json
**/skills/**/reported_evidence.json

# Private configuration, credentials, editor state and runtime artifacts.
.env
.env.*
*.local.*
settings.local.json
auth.json
credentials.json
*.pem
*.key
id_rsa*
id_ed25519*
.DS_Store
.idea/
.vscode/
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.Rhistory
.RData
.Rproj.user/
*.log
*.sqlite
*.sqlite3
*.db
*.pdf
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.dta
*.parquet
*.feather
*.rds
*.Rds
*.pkl
